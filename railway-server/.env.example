# Google Drive — Service Account
DRIVE_FOLDER_ID=
DRIVE_SERVICE_ACCOUNT_EMAIL=
DRIVE_PRIVATE_KEY=

# Token pour le endpoint POST /reload
# Générer un token aléatoire, ex: openssl rand -hex 32
RELOAD_TOKEN=

# Authentification archiviste (dashboard + registre privés)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Secret pour signer les JWT de session
# Générer un secret aléatoire, ex: openssl rand -hex 32
SESSION_SECRET=

# Port (fourni automatiquement par Railway, pas besoin de le définir manuellement)
# PORT=3000
